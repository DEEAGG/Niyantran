# NIYANTRAN — Environment Configuration Template
# Duplicate this file to .env for local development

# Application Environment (development | production)
NIYANTRAN_ENV=development

# Server Port
PORT=8000

# CORS Allowed Origins (comma-separated, or leave empty for local development defaults)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication Secret Key (generate a strong 32+ character random string in production)
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Optional Database & Storage Paths (defaults to local data/ directory)
# NIYANTRAN_DB_PATH=data/niyantran.db
# NIYANTRAN_DATA_DIR=data

# Optional OCR Engine Path (defaults to system PATH or standard installation directory)
# TESSERACT_CMD=/usr/bin/tesseract
