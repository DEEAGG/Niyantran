from fastapi import FastAPI, UploadFile, File, HTTPException
from pypdf import PdfReader
from PIL import Image
import pytesseract
pytesseract.pytesseract.tesseract_cmd = r"C:\Program Files\Tesseract-OCR\tesseract.exe"
import fitz
import io

app = FastAPI(title="Niyantran API", version="0.3.0")
MAX_FILE_SIZE = 10 * 1024 * 1024

@app.get("/")
def home():
    return {"project": "Niyantran", "status": "running"}

@app.get("/api/health")
def health():
    return {"status": "healthy"}

@app.get("/api/ocr/status")
def ocr_status():
    return {"available": True, "version": str(pytesseract.get_tesseract_version()), "pdf_ocr": True}

@app.post("/api/documents/extract")
async def extract_document(file: UploadFile = File(...)):
    filename = (file.filename or "").lower()
    if not filename.endswith((".pdf", ".png", ".jpg", ".jpeg")):
        raise HTTPException(status_code=400, detail="Upload a PDF, PNG or JPG")
    content = await file.read(MAX_FILE_SIZE + 1)
    if len(content) > MAX_FILE_SIZE:
        raise HTTPException(status_code=413, detail="Maximum file size is 10 MB")
    if not content:
        raise HTTPException(status_code=400, detail="File is empty")
    try:
        if filename.endswith(".pdf"):
            pdf = fitz.open(stream=content, filetype="pdf")
            pages = []
            try:
                for number, page in enumerate(pdf, start=1):
                    text = page.get_text().strip()
                    method = "PDF text extraction"
                    if len(text) < 20:
                        pix = page.get_pixmap(matrix=fitz.Matrix(2, 2), alpha=False)
                        image = Image.open(io.BytesIO(pix.tobytes("png")))
                        text = pytesseract.image_to_string(image).strip()
                        method = "Tesseract OCR"
                    pages.append({"page": number, "method": method, "text": text})
            finally:
                pdf.close()
            return {"filename": file.filename, "pages_processed": len(pages), "pages": pages, "text": "\n\n".join("--- Page " + str(p["page"]) + " ---\n" + p["text"] for p in pages)}
        image = Image.open(io.BytesIO(content))
        return {"filename": file.filename, "method": "Tesseract OCR", "text": pytesseract.image_to_string(image).strip()}
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(status_code=400, detail="Could not read the file: " + str(exc))
    finally:
        await file.close()
