{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "excludeFiles": "frontend/node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__niyantran_path=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__niyantran_path=/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/index.py?__niyantran_path=/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__niyantran_path=/$1"
    }
  ]
}
