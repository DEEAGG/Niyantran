{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "^/api$",
      "dest": "https://niyantran-three.vercel.app/api"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://niyantran-three.vercel.app/api/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
