{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "excludeFiles": "frontend/**"
    }
  },
  "routes": [
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "/api/index.py?__niyantran_path=/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
