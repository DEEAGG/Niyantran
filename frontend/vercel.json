{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api$",
      "dest": "https://niyantran-three.vercel.app/api"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://niyantran-three.vercel.app/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
